msgid "`x`, `y`"
msgstr "`x`, `y`"

#: ../../source/get_started/kinematics.md:9
msgid "Position in the world frame"
msgstr "世界坐标系中的位置"

#: ../../source/get_started/kinematics.md:9
msgid "m"
msgstr "m"

#: ../../source/get_started/kinematics.md:9
msgid "`theta`"
msgstr "`theta`"

#: ../../source/get_started/kinematics.md:9
msgid "Heading from world +x toward +y; positive counterclockwise"
msgstr "从世界坐标系 +x 轴朝 +y 轴的航向角，逆时针为正"

#: ../../source/get_started/kinematics.md:9
msgid "rad"
msgstr "rad"

#: ../../source/get_started/kinematics.md:9
msgid "`v`"
msgstr "`v`"

#: ../../source/get_started/kinematics.md:9
msgid "Forward speed in the robot's frame"
msgstr "机器人坐标系中的前向速度"

#: ../../source/get_started/kinematics.md:9
